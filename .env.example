# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Only FRED_API_KEY is required for a full run. Everything else is optional,
# and the survivorship analysis needs no keys at all — it reads SEC EDGAR,
# which is free and unauthenticated.

# Macro series (Treasury yields, CPI, HY spreads). Free key:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Contact address sent to SEC EDGAR in the User-Agent header. Required by SEC
# Fair Access for automated requests, and enforced by utils/config.py — any
# EDGAR fetch raises without it. Use an address you actually read; the SEC
# contacts operators here before throttling them.
# https://www.sec.gov/os/webmaster-faq#developers
SEC_CONTACT_EMAIL=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional. Absolute path to the .env file itself, if you keep it outside the
# repo. Unset, the loader looks for <repo root>/.env and then one level up.
# FORM25_ENV_FILE=
